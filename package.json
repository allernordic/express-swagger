{
  "name": "@aller/express-swagger",
  "version": "0.3.3",
  "description": "Adds a Swagger / OpenAPI v3 specification to an Express application, derived automatically from the types of the routes registered on the app.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "bin": {
    "express-swagger": "./bin/express-swagger.js"
  },
  "workspaces": [
    "example",
    "example-ts"
  ],
  "files": [
    "bin",
    "src",
    "lib",
    "types/index.d.ts",
    "types/index.d.ts.map"
  ],
  "scripts": {
    "test": "mocha",
    "posttest": "npm run toc && npm run lint && npm run tsc && npm run test:md && npm run build",
    "lint": "eslint . --cache && prettier . -c",
    "tsc": "tsc --noEmit && tsc -p test",
    "toc": "toc -c README.md",
    "build": "rollup -c && node ./scripts/build-types.js",
    "prepublishOnly": "npm run toc && npm run build",
    "cov:html": "c8 -n src -r html -r text mocha",
    "example:prebuild": "node bin/express-swagger.js example/index.js --out example/public/swagger.json",
    "example-ts:prebuild": "node --experimental-strip-types --no-warnings bin/express-swagger.js example-ts/index.ts --out example-ts/public/swagger.json",
    "test:md": "texample ./README.md"
  },
  "keywords": [
    "swagger",
    "express",
    "openapi"
  ],
  "author": {
    "name": "Aller Media",
    "url": "https://github.com/allernordic"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allernordic/express-swagger.git"
  },
  "homepage": "https://github.com/allernordic/express-swagger",
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.1.1",
      "yargs": "^18.1.0"
    }
  },
  "devDependencies": {
    "@0dep/toc": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "dts-buddy": "^0.8.0",
    "eslint": "^10.2.1",
    "express": "^5.2.1",
    "globals": "^17.5.0",
    "mocha": "^11.7.5",
    "mocha-cakes-2": "^3.3.0",
    "openapi-schema-validator": "^12.1.3",
    "prettier": "^3.8.3",
    "rollup": "^4.60.2",
    "supertest": "^7.2.2",
    "texample": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "debug": "^4.0.0",
    "typescript": ">=5.0.0 <7"
  }
}
